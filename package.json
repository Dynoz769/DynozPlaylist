{
  "name": "dynoz-playlist",
  "version": "1.0.0",
  "private": true,
  "description": "Rak peribadi untuk semua playlist Dynoz: Spotify, YouTube, SoundCloud, Apple Music dan lain-lain.",
  "type": "module",
  "scripts": {
    "start": "node server.js --open",
    "serve": "node server.js",
    "lan": "node server.js --lan",
    "deploy": "npx --yes wrangler deploy",
    "online": "npx --yes wrangler dev",
    "online:log": "npx --yes wrangler tail"
  },
  "engines": {
    "node": ">=20"
  }
}
